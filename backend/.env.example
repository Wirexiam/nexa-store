DATABASE_URL=sqlite:///./data/nexa_store.db
ADMIN_API_KEY=nexa-dev-admin
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Telegram administrator notifications. Leave both empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
TELEGRAM_TIMEOUT_SECONDS=5

# Local in-process fulfillment worker and isolated Chromium settings.
EXECUTION_MAX_WORKERS=4
BROWSER_HEADLESS=true

# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://nexa:nexa@localhost:5432/nexa_store
